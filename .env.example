# ------------------------------------------------------------------
# Maison Gourmande — variables d'environnement
# Copiez ce fichier vers .env.local (développement) ou .env (production)
# Ne commitez jamais .env.local ni aucun secret.
# ------------------------------------------------------------------

# Secret de signature des sessions admin (min. 32 caractères aléatoires)
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Identifiants admin utilisés par npm run db:seed et npm run db:create-admin.
# ADMIN_PASSWORD est facultatif : s'il manque, un mot de passe aléatoire est affiché.
# Choisissez un mot de passe fort et unique, puis supprimez ces lignes après usage.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Gérante Maison Gourmande
# SUPER_ADMIN (défaut), MANAGER ou STAFF — utilisé par db:create-admin.
ADMIN_ROLE=SUPER_ADMIN

# PostgreSQL en production. Laisser vide en développement pour utiliser
# la base PostgreSQL embarquée (PGlite) dans .data/pgdata.
# Exemple : postgresql://user:password@host:5432/maison_gourmande?sslmode=require
DATABASE_URL=

# Répertoire local optionnel de PGlite (défaut : .data/pgdata).
# PGLITE_DIR=.data/pgdata

# Répertoire des médias téléversés en local (facultatif).
# En production, privilégiez un stockage objet (S3, R2, Supabase Storage…).
MEDIA_DIR=public/uploads

# URL publique du site, utile pour les liens absolus.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numéro WhatsApp de secours (format international sans +).
# Le numéro réel est stocké en base et se modifie dans Admin > Paramètres.
WHATSAPP_FALLBACK=221709815201
